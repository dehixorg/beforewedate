# ==========================================
# Azure Configuration - SERVER SIDE ONLY
# ==========================================

# Azure OpenAI
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
AZURE_OPENAI_API_KEY=your-api-key
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small

# Azure AI Content Safety
AZURE_CONTENT_SAFETY_ENDPOINT=https://<your-resource>.cognitiveservices.azure.com/
AZURE_CONTENT_SAFETY_API_KEY=your-api-key

# Azure Foundry (Agent Service)
AZURE_FOUNDRY_ENDPOINT=https://<your-resource>.openai.azure.com/
AZURE_FOUNDRY_API_KEY=your-api-key
AZURE_FOUNDRY_PROJECT_CONNECTION_STRING=your-connection-string
